{
  "extends": "@etm/tsconfig/internal-package.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "rootDir": "."
  },
  "include": [
    "src",
    "*.ts",
