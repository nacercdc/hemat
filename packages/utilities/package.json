{
  "name": "@etm/utilities",
  "private": true,
  "version": "0.1.0",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "require": "./dist/",
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsup",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@etm/eslint-config": "workspace:*",
    "@etm/prettier-config": "workspace:*",
    "@etm/tsconfig": "workspace:*",
    "@types/lodash.get": "^4",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "lodash.get": "^4.4.2"
  }
}
