    "class-variance-authority": "^0.7.1",
    "eslint": "^9.12.0",
    "lodash.get": "^4.4.2",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "@types/react": "^19.0.3",
    "zod": "3.23.8"
  }
}
