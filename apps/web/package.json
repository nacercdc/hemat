{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn with-env next build",
    "dev": "yarn with-env next dev",
    "start": "yarn with-env next start",
    "test": "vitest",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@etm/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.59.15",
    "firebase": "^11.1.0",
    "geist": "^1.3.1",
    "mini-css-extract-plugin": "^2.9.1",
    "next": "^15.1.3",
    "raf": "^3.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "2.2.1",
    "vercel": "latest",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@etm/eslint-config": "workspace:*",
    "@etm/prettier-config": "workspace:*",
    "@etm/tailwind-config": "workspace:*",
    "@etm/tsconfig": "workspace:*",
    "@types/node": "^20.14.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.12.0",
    "eslint-config-next": "^14.2.3",
    "jiti": "^1.21.6",
    "next-compose-plugins": "^2.2.1",
    "next-transpile-modules": "^10.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tree-kill": "^1.2.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  },
  "prettier": "@etm/prettier-config"
}
