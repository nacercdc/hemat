# Application
NODE_ENV=development
APP_NAME=HIEMAT
APP_VERSION=1.0
APP_PORT=8080
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
THROTTLE_TTL=6000
THROTTLE_LIMIT=10
THROTTLE_BLOCK_DURATION=3600
FRONTEND_DOMAIN=https://africa-cdc-web-501628761718.us-west1.run.app
BACKEND_DOMAIN=https://africa-cdc-hemat-api-501628761718.us-west1.run.app

# Database
DATABASE_TYPE=postgres
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# Auth
AUTH_JWT_TOKEN_EXPIRES_IN=1m
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_TOKEN_EXPIRES_IN=15 #In minutes
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=15 