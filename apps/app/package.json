{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "dev:android": "expo start --android",
    "android": "yarn env:pull && expo run:android",
    "prebuilt:android": "yarn env:pull && expo prebuild --platform android",
    "dev:android:production": "yarn env:pull:production && expo start --android",
    "android:production": "yarn env:pull:production && expo run:android",
    "prebuilt:android:production": "yarn env:pull:production && expo prebuild --platform android",
    "dev:ios": "yarn env:pull && yarn expo start --ios ",
    "ios": "yarn env:pull && yarn expo run:ios",
    "prebuilt:ios": "yarn env:pull && yarn expo prebuild --platform ios",
    "dev:ios:production": "yarn env:pull:production && expo start --ios ",
    "ios:production": "yarn env:pull:production && expo run:ios",
    "prebuilt:ios:production": "yarn env:pull:production && expo prebuild --platform ios",
    "test": "jest --watchAll",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "env:pull": "eas env:pull development",
    "env:pull:preview": "eas env:pull preview",
    "env:pull:production": "eas env:pull production",
    "build:gradle:production": "yarn bundle:production && cd ./android && ./gradlew app:assembleRelease && mv ./app/build/outputs/apk/release/app-release.apk ./app/build/outputs/apk/release/expo.apk",
    "build:gradle": "yarn bundle && cd ./android && ./gradlew app:assembleRelease && mv ./app/build/outputs/apk/release/app-release.apk ./app/build/outputs/apk/release/expo.apk",
    "bundle:production": "rm -rf ./android/app/src/main/assets && mkdir ./android/app/src/main/assets && yarn env:pull:production npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "bundle": "rm -rf ./android/app/src/main/assets && mkdir ./android/app/src/main/assets && yarn env:pull && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@e-market/nativewindui-theme-config": "workspace:*",
    "@e-market/rn-firebase": "workspace:*",
    "@e-market/rn-ui-components": "workspace:*",
    "@e-market/tanstack-query-api": "workspace:*",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-firebase/app": "^21.6.2",
    "@react-native-firebase/auth": "^21.6.2",
    "@react-native-firebase/crashlytics": "^21.6.2",
    "@react-native-firebase/firestore": "^21.6.2",
    "@rn-primitives/hooks": "^1.1.0",
    "@roninoss/icons": "^0.0.4",
    "@tanstack/react-query": "^5.59.15",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^52.0.25",
    "expo-blur": "~14.0.1",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.5",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.5",
    "expo-navigation-bar": "^4.0.7",
    "expo-router": "^4.0.16",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~4.0.3",
    "i18next": "^24.2.2",
    "intl-pluralrules": "^2.0.1",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.4.0",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "2.12.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-uitextview": "^1.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@e-market/eslint-config": "workspace:*",
    "@e-market/prettier-config": "workspace:*",
    "@e-market/tailwind-config": "workspace:*",
    "@e-market/tsconfig": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.12.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.2",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
