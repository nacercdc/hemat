{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "yarn postinstall && expo start --dev-client",
    "dev:android": "yarn postinstall && expo start --android",
    "android": "yarn postinstall &&  expo run:android",
    "prebuilt:android": "yarn postinstall && expo prebuild --platform android ",
    "dev:ios": "yarn postinstall && expo start --ios ",
    "ios": "yarn postinstall && expo run:ios",
    "prebuilt:ios": "yarn postinstall && expo prebuild --platform ios",
    "test": "jest --watchAll",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "npx patch-package",
    "build:gradle:prod": "yarn bundle:prod && cd ./android && ./gradlew app:assembleRelease && mv ./app/build/outputs/apk/release/app-release.apk ./app/build/outputs/apk/release/expo.apk",
    "build:gradle:stage": "yarn bundle:stage && cd ./android && ./gradlew app:assembleRelease && mv ./app/build/outputs/apk/release/app-release.apk ./app/build/outputs/apk/release/expo.apk",
    "bundle:prod": "rm -rf ./android/app/src/main/assets && mkdir ./android/app/src/main/assets && NODE_ENV=prod npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "bundle:stage": "rm -rf ./android/app/src/main/assets && mkdir ./android/app/src/main/assets && NODE_ENV=stage npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@eva-design/eva": "^2.2.0",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-firebase/app": "^21.6.2",
    "@react-native-firebase/auth": "^21.6.2",
    "@react-native-firebase/crashlytics": "^21.6.2",
    "@react-native-firebase/firestore": "^21.6.2",
    "@tanstack/react-query": "^5.59.15",
    "@ui-kitten/components": "^5.3.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^52.0.25",
    "expo-blur": "~14.0.1",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.3",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.3",
    "expo-router": "^4.0.16",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~4.0.3",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@etm/eslint-config": "workspace:*",
    "@etm/prettier-config": "workspace:*",
    "@etm/tailwind-config": "workspace:*",
    "@etm/tsconfig": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.12.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.2",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "private": true
}
