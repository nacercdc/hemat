{
  "name": "e-market",
  "description": "A unified E-market monorepo designed to manage the backend, web, and mobile applications efficiently.",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*",
    "./tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F web...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:development": "APP_ENV=development && yarn workspace app android:development",
    "dev:android:development": "APP_ENV=development && yarn workspace app dev:android:development",
    "android:prebuilt:development": "APP_ENV=development && yarn workspace app android:prebuilt:development",
    "android:production": "APP_ENV=production && yarn workspace app android:production",
    "dev:android:production": "APP_ENV=production && yarn workspace app dev:android:production",
    "android:prebuilt:production": "APP_ENV=production && yarn workspace app android:prebuilt:production",
    "ios:development": "APP_ENV=development && yarn workspace app ios:development",
    "dev:ios:development": "APP_ENV=development && yarn workspace app dev:ios:development",
    "ios:prebuilt:development": "APP_ENV=development && yarn workspace app ios:prebuilt:development",
    "ios:production": "APP_ENV=production && yarn workspace app ios:production",
    "dev:ios:production": "APP_ENV=production && yarn workspace app dev:ios:production",
    "ios:prebuilt:production": "APP_ENV=production && yarn workspace app ios:prebuilt:production",
    "lib:gen": "yarn turbo gen init",
    "ui-add": "turbo run ui-add",
    "postinstall": "yarn workspace app postinstall",
    "build:gradle:development": "yarn workspace app build:gradle:development",
    "build:gradle:production": "yarn workspace app build:gradle:production"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.12",
    "react-refresh": "^0.14.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "add": "^2.0.6",
    "check-dependency-version-consistency": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "node-gyp": "^10.1.0",
    "tailwind-merge": "^2.6.0",
    "vitest": "^2.1.1",
    "workspace": "^0.0.1-preview.2"
  },
  "devDependencies": {
    "@e-market/prettier-config": "workspace:*",
    "@turbo/gen": "^2.3.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "22",
    "npm": "10.8"
  }
}
