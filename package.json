{
  "name": "yarn-monorepo-starter",
  "description": "A starter template for monorepo projects with Yarn Workspaces, maintained by ETM Software PLC.",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*",
    "./tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:nextjs": "turbo watch dev -F nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "yarn workspace expo-app android",
    "dev:android": "yarn workspace expo-app dev:android",
    "android:prebuilt": "yarn workspace expo-app android:prebuilt",
    "ios": "yarn workspace expo-app ios",
    "dev:ios": "yarn workspace expo-app dev:ios",
    "ios:prebuilt": "yarn workspace expo-app ios:prebuilt",
    "lib:gen": "yarn turbo gen init",
    "ui-add": "turbo run ui-add",
    "build:gradle:stage": "yarn workspace expo-app build:gradle:stage",
    "build:gradle:prod": "yarn workspace expo-app build:gradle:prod"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.12",
    "react-refresh": "^0.14.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "check-dependency-version-consistency": "^4.1.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "node-gyp": "^10.1.0",
    "vitest": "^2.1.1"
  },
  "devDependencies": {
    "@etm/prettier-config": "workspace:*",
    "@turbo/gen": "^2.3.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "22",
    "npm": "10.8"
  }
}
