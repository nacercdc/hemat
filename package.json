{
  "name": "e-market",
  "description": "A unified E-market monorepo designed to manage the backend, web, and mobile applications efficiently.",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*",
    "./tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "rm -rf node_modules **/node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:web": "yarn workspace web dev",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "yarn workspace app android",
    "dev:android": "yarn workspace app dev:android",
    "android:prebuilt": "yarn workspace app android:prebuilt",
    "android:production": "yarn workspace app android:production",
    "dev:android:production": "yarn workspace app dev:android:production",
    "android:prebuilt:production": "yarn workspace app android:prebuilt:production",
    "ios": "yarn workspace app ios",
    "dev:ios": "yarn workspace app dev:ios",
    "ios:prebuilt": "yarn workspace app ios:prebuilt",
    "ios:production": "yarn workspace app ios:production",
    "dev:ios:production": "yarn workspace app dev:ios:production",
    "ios:prebuilt:production": "yarn workspace app ios:prebuilt:production",
    "app:env:pull": "yarn workspace app env:pull",
    "app:env:pull:preview": "yarn workspace app env:pull:preview",
    "app:env:pull:production": "yarn workspace app env:pull:production",
    "lib:gen": "yarn turbo gen init",
    "ui-add": "turbo run ui-add",
    "build:gradle": "yarn workspace app build:gradle",
    "build:gradle:production": "yarn workspace app build:gradle:production"
  },
  "resolutions": {
    "@tanstack/react-query": "^5.59.15",
    "@tanstack/query-core": "5.66.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "@tanstack/query-core": "5.66.0",
    "@tanstack/react-query": "^5.59.15",
    "add": "^2.0.6",
    "check-dependency-version-consistency": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "node-gyp": "^10.1.0",
    "tailwind-merge": "^2.6.0",
    "vitest": "^2.1.1",
    "workspace": "^0.0.1-preview.2"
  },
  "devDependencies": {
    "@e-market/prettier-config": "workspace:*",
    "@turbo/gen": "^2.3.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "22",
    "npm": "10.8"
  }
}
